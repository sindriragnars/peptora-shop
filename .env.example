# peptora-shop env vars
#
# Local dev: copy to .env.local and fill in. Production: set the same
# variables in the Vercel project's Environment Variables panel.

# ─── Upstash Redis (order log) ───────────────────────────────────────────────
# Provision via Vercel marketplace integration. The integration
# auto-injects these vars into the project on first connect. For local
# dev, copy the values from the Vercel project dashboard.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ─── Resend (transactional email) ────────────────────────────────────────────
# Get a key at https://resend.com (free tier 3,000 emails/month).
RESEND_API_KEY=
# Fallback "from" address used until a tenant verifies its own sender
# domain in Resend. Must be on a domain we control (e.g. peptora.app).
PLATFORM_EMAIL_FROM=orders@peptora.app

# ─── Per-tenant Revolut credentials ──────────────────────────────────────────
# Each tenant connects its own Revolut Business account. The env-var
# NAME is referenced from tenant.json (revolut.apiKeyRef / .webhookSecretRef);
# the VALUE lives only here / in Vercel.
#
# Pattern: <TENANT_SLUG_UPPERCASE>_REVOLUT_API_KEY and ..._WEBHOOK_SECRET.
#
# To add a real tenant:
#   1. Tenant signs up for Revolut Business + verifies KYC
#   2. In Revolut Merchant section, generate API key + register webhook
#      URL https://peptora-shop.vercel.app/api/webhook/<slug>
#   3. Add the two env vars below with the values Revolut shows
#   4. Update tenant.json revolut.apiKeyRef / .webhookSecretRef to match
DEMO_REVOLUT_API_KEY=
DEMO_REVOLUT_WEBHOOK_SECRET=

# ─── Per-tenant admin password (Basic Auth on /<slug>/admin/*) ───────────────
# Convention: <SLUG_UPPER>_ADMIN_PASSWORD. Hyphens in the slug become
# underscores. Username for Basic Auth is always "admin".
#
# Generate via:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# Without this set the /<slug>/admin/* routes return 401 and the tenant
# can't access the orders dashboard.
DEMO_ADMIN_PASSWORD=

# ─── Platform admin (Basic Auth on /admin/*, no slug) ────────────────────────
# Gates /admin/signups and any future platform-wide admin pages. Distinct
# from per-tenant DEMO_ADMIN_PASSWORD so a tenant breach can't escalate.
# Generate same way as the per-tenant password above.
PLATFORM_ADMIN_PASSWORD=

# Destination for "new signup application" notification emails (Phase 7).
# Best-effort: if empty, the email is skipped but the application still
# saves to Redis and shows up at /admin/signups for manual review.
PLATFORM_ADMIN_EMAIL=info@peptora.app

# ─── Per-tenant Stripe credentials (smoke-test alternative to Revolut) ───────
# Pattern: <TENANT_SLUG_UPPER>_STRIPE_SECRET_KEY + ..._WEBHOOK_SECRET.
# Used when PAYMENT_PROVIDER=stripe (set as a project-wide env var).
DEMO_STRIPE_SECRET_KEY=
DEMO_STRIPE_WEBHOOK_SECRET=
PAYMENT_PROVIDER=stripe
